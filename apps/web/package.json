{
  "name": "@retail-recommendation-lab/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "prettier --check .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run src",
    "test:coverage": "vitest run --coverage src",
    "audit": "npm audit --audit-level=high",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
