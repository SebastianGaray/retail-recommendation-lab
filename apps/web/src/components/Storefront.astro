---
import "../styles/global.css";

import type { Locale } from "../lib/catalog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  en: {
    skip: "Skip to catalog",
    eyebrow: "Synthetic retail sandbox",
    title: "Retail Recommendation Lab",
    intro: "Explore how a transparent popularity baseline reacts to your local cart.",
    synthetic: "All products, prices, reviews and behavior are fictional and generated for education.",
    catalog: "Catalog",
    catalogHint: "Add products to shape this browser-only session.",
    cart: "Your cart",
    empty: "Your cart is empty.",
    recommendations: "Recommendations",
    recommendationHint: "Deterministic baseline · excludes items already in your cart",
    add: "Add to cart",
    remove: "Remove",
    soldOut: "Out of stock",
    theme: "Theme",
    system: "System",
    light: "Light",
    dark: "Dark",
    language: "Language",
    fallback: "Image unavailable",
    reason: "Recommended for its synthetic popularity score.",
    strategy: "Strategy", methodology: "Offline PySpark artifacts; your cart stays in this browser.", error: "Recommendation artifacts are unavailable.",
    popularity: "Popularity", categoryPopularity: "Category popularity", frequentlyBoughtTogether: "Frequently bought together", itemSimilarity: "Item similarity",
    hybrid: "Hybrid",
    global_popularity: "Popular across synthetic sessions.", category_popularity: "Popular in a cart category.", frequently_bought_together: "Frequently purchased with a cart item.", item_similarity: "Similar synthetic interaction patterns.", cold_start_fallback: "Popularity fallback for a sparse cart.",
    hybrid_ranker: "Selected by a transparent weighted hybrid.", comparison: "Offline strategy comparison", comparisonNote: "Synthetic held-out purchases after the chronological cutoff. These metrics are not a production benchmark.", precision: "Precision@3", recall: "Recall@3", hitRate: "Hit rate@3", coverage: "Catalog coverage", scoreVsRules: "Model scores combine normalized signals. Inventory, cart exclusion, category caps and stable tie-breaking determine final rank.",
    statusAdded: "added to cart",
    statusRemoved: "removed from cart",
  },
  es: {
    skip: "Ir al catálogo",
    eyebrow: "Laboratorio de retail sintético",
    title: "Retail Recommendation Lab",
    intro: "Explora cómo una línea base transparente reacciona a tu carrito local.",
    synthetic: "Todos los productos, precios, reseñas y comportamientos son ficticios y generados con fines educativos.",
    catalog: "Catálogo",
    catalogHint: "Agrega productos para modificar esta sesión en tu navegador.",
    cart: "Tu carrito",
    empty: "Tu carrito está vacío.",
    recommendations: "Recomendaciones",
    recommendationHint: "Línea base determinista · excluye productos que ya están en tu carrito",
    add: "Agregar al carrito",
    remove: "Quitar",
    soldOut: "Sin stock",
    theme: "Tema",
    system: "Sistema",
    light: "Claro",
    dark: "Oscuro",
    language: "Idioma",
    fallback: "Imagen no disponible",
    reason: "Recomendado por su puntaje de popularidad sintético.",
    strategy: "Estrategia", methodology: "Artefactos PySpark sin conexión; tu carrito permanece en este navegador.", error: "Los artefactos de recomendación no están disponibles.",
    popularity: "Popularidad", categoryPopularity: "Popularidad por categoría", frequentlyBoughtTogether: "Comprados juntos", itemSimilarity: "Similitud de productos",
    hybrid: "Híbrida",
    global_popularity: "Popular en sesiones sintéticas.", category_popularity: "Popular en una categoría del carrito.", frequently_bought_together: "Comprado frecuentemente con un producto del carrito.", item_similarity: "Patrones de interacción sintéticos similares.", cold_start_fallback: "Popularidad de respaldo para un carrito disperso.",
    hybrid_ranker: "Seleccionado por una combinación ponderada transparente.", comparison: "Comparación offline de estrategias", comparisonNote: "Compras sintéticas retenidas después del corte cronológico. Estas métricas no son un benchmark de producción.", precision: "Precisión@3", recall: "Cobertura de relevantes@3", hitRate: "Tasa de acierto@3", coverage: "Cobertura de catálogo", scoreVsRules: "El puntaje combina señales normalizadas. Inventario, exclusión del carrito, límites por categoría y desempate estable determinan el rango final.",
    statusAdded: "agregado al carrito",
    statusRemoved: "quitado del carrito",
  },
}[locale];
const otherLocale = locale === "en" ? "es" : "en";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={copy.intro} />
    <title>{copy.title}</title>
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem("rrl-theme") ?? "system";
    </script>
  </head>
  <body
    data-locale={locale}
    data-catalog-url={`${base}catalog.json`}
    data-artifact-base={base}
    data-evaluation-url={`${base}evaluation-summary.json`}
    data-copy={JSON.stringify(copy)}
  >
    <a class="skip-link" href="#catalog">{copy.skip}</a>
    <header>
      <a class="brand" href={`${base}${locale}/`} aria-label={copy.title}>RRL</a>
      <nav aria-label={copy.language}>
        <a href={`${base}${otherLocale}/`} lang={otherLocale}>{otherLocale.toUpperCase()}</a>
        <label>
          <span>{copy.theme}</span>
          <select id="theme">
            <option value="system">{copy.system}</option>
            <option value="light">{copy.light}</option>
            <option value="dark">{copy.dark}</option>
          </select>
        </label>
      </nav>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 id="page-title">{copy.title}</h1>
          <p class="lede">{copy.intro}</p>
        </div>
        <p class="notice">{copy.synthetic}</p>
      </section>

      <div class="workspace">
        <section id="catalog" aria-labelledby="catalog-title">
          <div class="section-heading">
            <div>
              <p class="index">01</p>
              <h2 id="catalog-title">{copy.catalog}</h2>
            </div>
            <p>{copy.catalogHint}</p>
          </div>
          <div id="product-grid" class="product-grid" aria-busy="true"></div>
        </section>

        <aside aria-labelledby="cart-title">
          <p class="index">02</p>
          <h2 id="cart-title">{copy.cart} <span id="cart-count">0</span></h2>
          <div id="cart-list"></div>
        </aside>
      </div>

      <section class="recommendations" aria-labelledby="recommendation-title">
        <div class="section-heading">
          <div>
            <p class="index">03</p>
            <h2 id="recommendation-title">{copy.recommendations}</h2>
          </div>
          <p>{copy.recommendationHint}</p>
        </div>
        <label>{copy.strategy} <select id="strategy"><option value="popularity">{copy.popularity}</option><option value="category-popularity">{copy.categoryPopularity}</option><option value="frequently-bought-together">{copy.frequentlyBoughtTogether}</option><option value="item-similarity">{copy.itemSimilarity}</option><option value="hybrid">{copy.hybrid}</option></select></label>
        <p>{copy.methodology}</p><p id="artifact-error" class="notice" hidden>{copy.error}</p>
        <div id="recommendation-grid" class="recommendation-grid"></div>
      </section>
      <section class="recommendations" aria-labelledby="comparison-title">
        <div class="section-heading"><div><p class="index">04</p><h2 id="comparison-title">{copy.comparison}</h2></div><p>{copy.comparisonNote}</p></div>
        <p>{copy.scoreVsRules}</p><div id="strategy-comparison" class="recommendation-grid" aria-live="polite"></div>
      </section>
    </main>
    <p id="cart-status" class="sr-only" aria-live="polite"></p>
    <script src="../scripts/storefront.ts"></script>
  </body>
</html>
