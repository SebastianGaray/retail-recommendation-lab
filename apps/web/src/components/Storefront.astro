---
import "../styles/global.css";
import type { Locale } from "../lib/catalog";
import { getLocaleConfig } from "../i18n/config";
import { getMessages } from "../i18n/messages";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getMessages(locale);
const localeMetadata = getLocaleConfig(locale);
const otherLocale = localeMetadata.alternate;
const portfolioLabel = copy.portfolio;
const viewLabels = {
  home: copy.home,
  catalog: copy.catalogNav,
  recommendations: copy.recommendations,
  evaluation: copy.evaluation,
};
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const canonical = new URL(`${base}${locale}/`, Astro.site);
const alternateEn = new URL(`${base}en/`, Astro.site);
const alternateEs = new URL(`${base}es/`, Astro.site);
const socialLocale = localeMetadata.ogLocale;
---

<!doctype html>
<html lang={locale}>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="description" content={copy.intro} /><meta
      name="theme-color"
      content="#4338ca"
    /><link rel="canonical" href={canonical} /><link
      rel="alternate"
      hreflang="en"
      href={alternateEn}
    /><link rel="alternate" hreflang="es" href={alternateEs} /><link
      rel="alternate"
      hreflang="x-default"
      href={alternateEn}
    /><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" /><meta
      property="og:type"
      content="website"
    /><meta property="og:site_name" content={copy.brand} /><meta
      property="og:title"
      content={copy.title}
    /><meta property="og:description" content={copy.intro} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:locale" content={socialLocale} /><meta
      property="og:locale:alternate"
      content={getLocaleConfig(otherLocale).ogLocale}
    /><meta name="twitter:card" content="summary" /><title>
      {copy.title} · {copy.brand}
    </title><script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("rrl-theme") ?? "system";
    </script></head
  >
  <body
    data-locale={locale}
    data-catalog-url={`${base}catalog.json`}
    data-artifact-base={base}
    data-evaluation-url={`${base}evaluation-summary.json`}
    data-copy={JSON.stringify(copy)}
  >
    <a class="skip-link" href="#catalog">{copy.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}${locale}/`}>{copy.brand}</a><nav
          aria-label={copy.menu}
        >
          <a href="https://sebastiangaray.github.io/"
            >{portfolioLabel}<span aria-hidden="true"> ↗</span></a
          ><a href="#methodology">{copy.methodologyNav}</a><a
            href={`${base}${otherLocale}/`}
            lang={otherLocale}
            aria-label={`${copy.language}: ${otherLocale.toUpperCase()}`}
            >{otherLocale.toUpperCase()}</a
          ><label class="theme-control"
            ><span class="sr-only">{copy.theme}</span><select id="theme"
              ><option value="system">{copy.system}</option><option
                value="light">{copy.light}</option
              ><option value="dark">{copy.dark}</option></select
            ></label
          ><button
            id="cart-open"
            class="icon-button"
            type="button"
            aria-haspopup="dialog"
            aria-controls="cart-dialog"
            aria-label={copy.cartOpen}
            >{copy.cart} <span id="cart-count">0</span></button
          >
        </nav>
      </div>
    </header>
    <aside class="lab-sidebar" aria-label={copy.menu}>
      <a href="#home" data-lab-view="home">{viewLabels.home}</a>
      <a href="#catalog" data-lab-view="catalog">{viewLabels.catalog}</a>
      <a href="#recommendations" data-lab-view="recommendations"
        >{viewLabels.recommendations}</a
      >
      <a href="#methodology" data-lab-view="methodology"
        >{viewLabels.evaluation}</a
      >
    </aside>
    <main>
      <section class="hero">
        <p class="disclosure">{copy.synthetic}</p><h1>{copy.title}</h1><p>
          {copy.intro}
        </p><a class="primary-action" href="#catalog"
          >{copy.viewRecommendations}</a
        >
      </section>
      <section
        id="catalog"
        class="catalog-section"
        aria-labelledby="catalog-title"
      >
        <div class="section-heading">
          <div>
            <p class="kicker">{copy.catalogKicker}</p><h2 id="catalog-title">
              {copy.catalog}
            </h2>
          </div><p>{copy.catalogHint}</p>
        </div>
        <div class="catalog-layout">
          <aside class="filters" aria-label={copy.filters}>
            <div class="filter-field">
              <label for="search">{copy.search}</label><input
                id="search"
                type="search"
                autocomplete="off"
              />
            </div><div class="filter-field">
              <label for="category">{copy.category}</label><select id="category"
                ><option value="">{copy.all}</option></select
              >
            </div><div class="filter-field">
              <label for="sort">{copy.sort}</label><select id="sort"
                ><option value="featured">{copy.featured}</option><option
                  value="price-asc">{copy.priceLow}</option
                ><option value="price-desc">{copy.priceHigh}</option><option
                  value="rating">{copy.rating}</option
                ></select
              >
            </div><div class="model-note">
              <span class="status-dot"></span><strong
                >{copy.offlineModel}</strong
              ><p>{copy.synthetic}</p>
            </div>
          </aside><div id="product-grid" class="product-grid" aria-busy="true">
          </div>
        </div>
      </section>
      <section
        id="recommendations"
        class="recommendations"
        aria-labelledby="recommendation-title"
      >
        <div class="section-heading">
          <div>
            <p class="kicker">{copy.rankingKicker}</p><h2
              id="recommendation-title"
            >
              {copy.recommendations}
            </h2>
          </div><p>{copy.recommendationHint}</p>
        </div><div class="strategy-bar">
          <label for="strategy">{copy.strategy}</label><select id="strategy"
            ><option value="popularity">{copy.popularity}</option><option
              value="category-popularity">{copy.categoryPopularity}</option
            ><option value="frequently-bought-together"
              >{copy.frequentlyBoughtTogether}</option
            ><option value="item-similarity">{copy.itemSimilarity}</option
            ><option value="hybrid">{copy.hybrid}</option></select
          ><button id="analyze-cart" type="button">{copy.analyze}</button>
        </div><p id="artifact-error" class="error-state" hidden>
          {copy.error}
        </p><div id="recommendation-grid" class="recommendation-grid"></div>
      </section>
      <section
        id="methodology"
        class="methodology"
        aria-labelledby="methodology-title"
      >
        <div class="section-heading">
          <div>
            <p class="kicker">{copy.evaluationKicker}</p><h2
              id="methodology-title"
            >
              {copy.comparison}
            </h2>
          </div><p>{copy.comparisonNote}</p>
        </div><div
          id="strategy-comparison"
          class="metric-grid"
          aria-live="polite"
        >
        </div><div class="technical-grid">
          <article>
            <span>01</span><h3>{copy.methodology}</h3><p>
              {copy.methodologyText}
            </p>
          </article><article>
            <span>02</span><h3>{copy.architecture}</h3><p>
              {copy.architectureText}
            </p>
          </article><article>
            <span>03</span><h3>{copy.limitations}</h3><p>
              {copy.limitationsText}
            </p>
          </article>
        </div>
      </section>
    </main>
    <footer>
      <strong>{copy.brand}</strong><span>{copy.synthetic}</span><a
        href="https://sebastiangaray.github.io/">{portfolioLabel} ↗</a
      ><a href="https://github.com/SebastianGaray/retail-recommendation-lab"
        >GitHub ↗</a
      >
    </footer>
    <dialog id="cart-dialog" class="drawer">
      <div class="drawer-head">
        <h2>{copy.cart}</h2><button
          type="button"
          data-close-cart
          aria-label={copy.close}>×</button
        >
      </div><div id="cart-list"></div><div class="cart-summary">
        <span>{copy.subtotal}</span><strong id="cart-subtotal">$0.00</strong>
      </div><a class="primary-action" href="#recommendations" data-close-cart
        >{copy.viewRecommendations}</a
      ><button id="reset-session" type="button">{copy.reset}</button>
    </dialog>
    <dialog id="product-dialog" class="product-dialog">
      <button
        class="dialog-close"
        type="button"
        data-close-product
        aria-label={copy.close}>×</button
      ><div id="product-detail"></div>
    </dialog>
    <p id="cart-status" class="sr-only" aria-live="polite"></p>
    <script src="../scripts/storefront.ts"></script>
  </body>
</html>
